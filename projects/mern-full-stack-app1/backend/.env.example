# Copy to .env. Use a fresh, random TOKEN_KEY with at least 32 bytes.
PORT=1198
MONGO_URL=mongodb://127.0.0.1:27017/full_stack
TOKEN_KEY=replace-with-a-random-secret-at-least-32-bytes
CLIENT_ORIGIN=http://localhost:3000,https://gurukul-task.web.app
NODE_ENV=development
COOKIE_SAME_SITE=lax

# In production, set NODE_ENV=production, keep CLIENT_ORIGIN limited to your
# deployed frontend, and use COOKIE_SAME_SITE=none when the frontend and API
# use different sites. Production cookies require HTTPS.
